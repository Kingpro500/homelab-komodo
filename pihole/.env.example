# pihole: example Stack Environment for Komodo.
# Copy into Komodo under Stack -> Environment. Never commit real values.
#
# Two instances share one Compose file and differ only in these values:
#   pc8-ct115-pihole -> 10.0.0.115  (Proxmox CT115 on pc8/pve)
#   pc9-ct116-pihole -> 10.0.0.116  (Proxmox CT116 on pc9)
#
# ---- pc8-ct115-pihole ----
PIHOLE_BIND_IP=10.0.0.115
PIHOLE_HOSTNAME=pihole-pc8
PIHOLE_WEB_PASSWORD=[[PIHOLE_PC8_WEB_PASSWORD]]
PIHOLE_UPSTREAM_DNS=10.0.0.1#53
PIHOLE_REVERSE_SERVERS=true,10.0.0.0/24,10.0.0.1#53,lan.local

# ---- pc9-ct116-pihole ----
# PIHOLE_BIND_IP=10.0.0.116
# PIHOLE_HOSTNAME=pihole-pc9
# PIHOLE_WEB_PASSWORD=[[PIHOLE_PC9_WEB_PASSWORD]]
# PIHOLE_UPSTREAM_DNS=10.0.0.1#53
# PIHOLE_REVERSE_SERVERS=true,10.0.0.0/24,10.0.0.1#53,lan.local

# ---- How these values work ----
# PIHOLE_BIND_IP        LAN address of this instance. Also the DNS server clients
#                       should receive from Kea, once DHCP is pointed here.
# PIHOLE_HOSTNAME       Hostname inside the container.
# PIHOLE_WEB_PASSWORD   Reference to a Komodo secret, never the value itself.
# PIHOLE_UPSTREAM_DNS   Single upstream: Unbound on OPNsense at 10.0.0.1.
#                       Unbound does the real resolution and reaches the internet.
# PIHOLE_REVERSE_SERVERS  Conditional forwarding for the local domain only.
#                       Format: enabled,CIDR,resolver#53,domain.
#                       Must match the Unbound Host Override domain, which is
#                       lan.local. Using internal here silently breaks local names.
