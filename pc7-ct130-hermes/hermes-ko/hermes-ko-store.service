[Unit]
Description=Hermes durable queue API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hermes
Environment=HOME=/home/hermes
ExecStart=/usr/bin/python3 /home/hermes/.hermes/scripts/hermes_ko_store.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
