[Unit]
Description=Observe Emby Download and Sync jobs (read-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hermes
Group=hermes
Environment=HOME=/home/hermes
Environment=HOMELAB_ENVFILE=/home/hermes/.hermes/.env
ExecStart=/usr/bin/python3 /home/hermes/.hermes/scripts/emby_sync_monitor.py
