{
  "uid": "proxmox-guests",
  "title": "Proxmox – Ressurser per maskin",
  "tags": ["proxmox", "resources", "guests"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "maskin",
        "label": "Maskin",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(proxmox_guest_mem_total_bytes, name)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Alle maskiner – nå",
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "format": "table",
          "expr": "proxmox_guest_up", "instant": true, "legendFormat": "{{name}}" },
        { "refId": "B", "format": "table",
          "expr": "proxmox_guest_cpu_percent", "instant": true, "legendFormat": "{{name}}" },
        { "refId": "C", "format": "table",
          "expr": "proxmox_guest_mem_used_bytes / 1073741824", "instant": true, "legendFormat": "{{name}}" },
        { "refId": "D", "format": "table",
          "expr": "proxmox_guest_mem_total_bytes / 1073741824", "instant": true, "legendFormat": "{{name}}" },
        { "refId": "E", "format": "table",
          "expr": "proxmox_guest_disk_used_bytes / 1073741824", "instant": true, "legendFormat": "{{name}}" },
        { "refId": "F", "format": "table",
          "expr": "proxmox_guest_disk_total_bytes / 1073741824", "instant": true, "legendFormat": "{{name}}" }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": true },
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null } ] } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "CPU %" },
            "properties": [ { "id": "unit", "value": "percent" },
              { "id": "custom.cellOptions", "value": { "type": "gauge",
                  "mode": "gradient", "max": 100, "min": 0 } } ] },
          { "matcher": { "id": "byName", "options": "RAM brukt (GiB)" },
            "properties": [ { "id": "unit", "value": "decdbytes" } ] },
          { "matcher": { "id": "byName", "options": "RAM total (GiB)" },
            "properties": [ { "id": "unit", "value": "decdbytes" } ] },
          { "matcher": { "id": "byName", "options": "Disk brukt (GiB)" },
            "properties": [ { "id": "unit", "value": "decdbytes" } ] },
          { "matcher": { "id": "byName", "options": "Disk total (GiB)" },
            "properties": [ { "id": "unit", "value": "decdbytes" } ] }
        ]
      },
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize",
          "options": { "renameByName": {
              "Time 1": "Opp", "name": "Maskin", "Value #B": "CPU %",
              "Value #C": "RAM brukt (GiB)", "Value #D": "RAM total (GiB)",
              "Value #E": "Disk brukt (GiB)", "Value #F": "Disk total (GiB)",
              "Value #A": "Opp" } } }
      ],
      "options": { "showHeader": true, "sortBy": [ { "displayName": "Maskin" } ] }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "CPU bruk – valgt maskin",
      "gridPos": { "h": 12, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A",
        "expr": "max by (name) (proxmox_guest_cpu_percent{name=~\"$maskin\"})", "instant": true }],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "yellow", "value": 50 },
            { "color": "orange", "value": 70 }, { "color": "red", "value": 90 } ] } },
        "overrides": []
      },
      "options": { "showThresholdLabels": true, "showThresholdMarkers": true,
        "orientation": "auto" }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "RAM fylling – valgt maskin",
      "gridPos": { "h": 12, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A",
        "expr": "max by (name) (proxmox_guest_mem_used_bytes{name=~\"$maskin\"}) / max by (name) (proxmox_guest_mem_total_bytes{name=~\"$maskin\"}) * 100",
        "instant": true }],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "yellow", "value": 70 },
            { "color": "orange", "value": 85 }, { "color": "red", "value": 95 } ] } },
        "overrides": []
      },
      "options": { "showThresholdLabels": true, "showThresholdMarkers": true,
        "orientation": "auto" }
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "Disk fylling – valgt maskin",
      "gridPos": { "h": 12, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A",
        "expr": "max by (name) (proxmox_guest_disk_used_bytes{name=~\"$maskin\"}) / max by (name) (proxmox_guest_disk_total_bytes{name=~\"$maskin\"}) * 100",
        "instant": true }],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "yellow", "value": 70 },
            { "color": "orange", "value": 85 }, { "color": "red", "value": 95 } ] } },
        "overrides": []
      },
      "options": { "showThresholdLabels": true, "showThresholdMarkers": true,
        "orientation": "auto" }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "RAM brukt / total – valgt maskin",
      "gridPos": { "h": 12, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A",
          "expr": "max by (name) (proxmox_guest_mem_used_bytes{name=~\"$maskin\"}) / 1073741824",
          "instant": true, "legendFormat": "brukt" },
        { "refId": "B",
          "expr": "max by (name) (proxmox_guest_mem_total_bytes{name=~\"$maskin\"}) / 1073741824",
          "instant": true, "legendFormat": "total" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "decdbytes",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "yellow", "value": 80 },
            { "color": "red", "value": 95 } ] } },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center",
        "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "CPU-kurve – valgt maskin",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A",
        "expr": "proxmox_guest_cpu_percent{name=~\"$maskin\"}", "legendFormat": "{{name}}" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100,
        "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "yellow", "value": 50 },
          { "color": "orange", "value": 70 }, { "color": "red", "value": 90 } ] } },
        "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "RAM-kurve (GiB) – valgt maskin",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 52 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A",
        "expr": "proxmox_guest_mem_used_bytes{name=~\"$maskin\"} / 1073741824",
        "legendFormat": "{{name}}" }],
      "fieldConfig": { "defaults": { "unit": "decdbytes",
        "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } },
        "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Disk-kurve (GiB) – valgt maskin",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 64 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A",
        "expr": "proxmox_guest_disk_used_bytes{name=~\"$maskin\"} / 1073741824",
        "legendFormat": "{{name}}" }],
      "fieldConfig": { "defaults": { "unit": "decdbytes",
        "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } },
        "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" } }
    }
  ]
}
