#!/usr/bin/env bash
# usb-nic-watchdog — tilbakestiller USB-nettverksadapteren (Realtek RTL8156, driver r8152)
# på en Proxmox-node når administrasjonsnettet har vært dødt i DEAD_AFTER sekunder.
#
# Bakgrunn (10. nov 2026): etter et nettverksblaff i boden kom pc7 aldri tilbake, fordi
# USB-adapteren hang seg. En "ut og inn" av adapteren fikser det; dette gjør det samme i
# programvare (USB authorized 0/1 = ny oppkobling), og kobler den til vmbr0 igjen.
#
# Kilde: GitHub Kingpro500/homelab-komodo, proxmox-hosts/usb-nic-watchdog/
# Installeres som /usr/local/sbin/usb-nic-watchdog + usb-nic-watchdog.service.
# DRY_RUN=1 viser hva den ville gjort uten å røre adapteren.
set -u

BR=${BR:-vmbr0}
TARGETS=${TARGETS:-"10.0.0.1 10.0.0.191 10.0.0.120"}   # OPNsense, ERX (switch), pc6
INTERVAL=${INTERVAL:-5}
DEAD_AFTER=${DEAD_AFTER:-30}     # sekunder uten svar fra NOEN mål før tilbakestilling
COOLDOWN=${COOLDOWN:-120}        # minst så mange sekunder mellom to tilbakestillinger
MAX_PER_HOUR=${MAX_PER_HOUR:-5}  # aldri mer enn dette per time (ingen loop)
BOOT_GRACE=${BOOT_GRACE:-180}    # ikke gjør noe de første sekundene etter oppstart
N8N=${N8N:-http://10.0.0.119:5678/webhook/events}
DRY_RUN=${DRY_RUN:-0}
LOGDIR=/var/log/usb-nic-watchdog
STATE=/var/lib/usb-nic-watchdog
mkdir -p "$LOGDIR" "$STATE"

log(){ echo "usb-nic-watchdog: $*"; }

usb_nic(){ # bro-porten som er en USB-enhet
  local p
  for p in /sys/class/net/"$BR"/brif/*; do
    p=$(basename "$p")
    [[ $(readlink -f /sys/class/net/"$p"/device 2>/dev/null) == */usb* ]] && { echo "$p"; return; }
  done
}

usb_dev(){ # sysfs-sti til selve USB-enheten (forelder til interface-mappen)
  local nic dev
  nic=$(usb_nic)
  if [[ -n $nic ]]; then
    dev=$(dirname "$(readlink -f /sys/class/net/"$nic"/device)")
    echo "$dev" > "$STATE/usbdev"; echo "$nic" > "$STATE/nic"
    echo "$dev"; return
  fi
  # Adapteren kan være borte som nettverksenhet: bruk sist kjente sti, ellers let etter RTL8156
  [[ -s $STATE/usbdev && -e $(cat "$STATE/usbdev")/authorized ]] && { cat "$STATE/usbdev"; return; }
  for dev in /sys/bus/usb/devices/*; do
    [[ $(cat "$dev"/idVendor 2>/dev/null) == 0bda && $(cat "$dev"/idProduct 2>/dev/null) == 8156 ]] && { echo "$dev"; return; }
  done
}

alive(){
  local t
  for t in $TARGETS; do ping -c1 -W1 -q "$t" >/dev/null 2>&1 && return 0; done
  return 1
}

notify(){ # best effort, aldri blokkerende
  curl -s -m 5 -o /dev/null -H 'Content-Type: application/json' -X POST "$N8N" \
    -d "{\"source\":\"usb-nic-watchdog\",\"type\":\"usb-lan\",\"severity\":\"warning\",\"title\":\"USB-LAN på $(hostname): $1\",\"message\":\"$2\",\"host\":\"$(hostname)\"}" || true
}

reset_usb(){
  local dev ts f nic
  dev=$(usb_dev); nic=$(cat "$STATE/nic" 2>/dev/null)
  ts=$(date +%Y%m%dT%H%M%S); f=$LOGDIR/$ts.log
  {
    echo "== $(hostname) $ts: ingen svar fra [$TARGETS] på ${DEAD_AFTER}s. Adapter: ${nic:-ukjent} ${dev:-ikke funnet}"
    ip -br link; echo; ethtool "${nic:-x}" 2>/dev/null | grep -E 'Speed|Duplex|Link detected'
    echo; echo "-- kjernelogg siste 5 min"; journalctl -k --since '-5min' --no-pager | grep -v promiscuous | tail -60
  } > "$f" 2>&1
  if [[ -z $dev ]]; then log "fant ikke USB-adapteren — kan ikke tilbakestille (se $f)"; return 1; fi
  if [[ $DRY_RUN == 1 ]]; then log "DRY_RUN: ville tilbakestilt $dev ($nic). Bevis: $f"; return 0; fi
  log "tilbakestiller $dev ($nic). Bevis: $f"
  echo 0 > "$dev/authorized"; sleep 3; echo 1 > "$dev/authorized"
  for _ in $(seq 1 20); do [[ -n $(usb_nic_raw) ]] && break; sleep 1; done
  ifreload -a >> "$f" 2>&1 || true
  sleep 5
  echo "$(date +%s)" >> "$STATE/resets"
}

usb_nic_raw(){ # adapteren tilbake som nettverksenhet (også før den er i broen)?
  local n; n=$(cat "$STATE/nic" 2>/dev/null); [[ -n $n && -e /sys/class/net/$n ]] && echo "$n"
}

resets_last_hour(){ local now; now=$(date +%s); awk -v n="$now" '$1>n-3600' "$STATE/resets" 2>/dev/null | wc -l; }

dead_since=0; last_reset=0; was_dead=0
log "startet: bro=$BR mål=[$TARGETS] død etter ${DEAD_AFTER}s, maks ${MAX_PER_HOUR}/t, DRY_RUN=$DRY_RUN"
usb_dev >/dev/null
while true; do
  now=$(date +%s); up=$(cut -d. -f1 /proc/uptime)
  if alive; then
    if (( was_dead )); then
      log "nettet er tilbake etter $(( now - dead_since ))s"; notify recovered "tilbake etter $(( now - dead_since ))s"
    fi
    dead_since=0; was_dead=0; usb_dev >/dev/null
  else
    (( dead_since == 0 )) && { dead_since=$now; log "ingen svar fra [$TARGETS]"; }
    was_dead=1
    if (( up > BOOT_GRACE && now - dead_since >= DEAD_AFTER && now - last_reset >= COOLDOWN )); then
      if (( $(resets_last_hour) >= MAX_PER_HOUR )); then
        log "maks ${MAX_PER_HOUR} tilbakestillinger siste time nådd — venter"
        last_reset=$now
      else
        reset_usb; last_reset=$(date +%s)
      fi
    fi
  fi
  sleep "$INTERVAL"
done
