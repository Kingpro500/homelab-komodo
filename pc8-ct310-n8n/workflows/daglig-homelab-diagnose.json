    {
      "id": "91b785b1-7668-44c0-bf03-d1597299cfc1",
      "name": "Hent diagnose",
      "notes": "Kaller Hermes-endepunktet paa CT157. Ingen av homelab-noeklene ligger i n8n.",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "url": "http://10.0.0.135:9118/audit",
        "authentication": "predefinedCredentialType",
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "sendHeaders": true,
        "nodeCredentialType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "TcgXN7shgc4X7U8w",
          "name": "Homelab Audit Header"
        }
      }
    },
    {
      "id": "6d15f5f4-920d-41c9-9a10-a17998d42e9e",
      "name": "Er noe nytt?",
      "notes": "False-grenen stopper med vilje, slik at du ikke faar push hver dag.",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-new",
              "leftValue": "={{ $json.new_findings.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "8cf1c1e6-676e-4b3b-9196-4f47961d882c",
      "name": "Er det kritisk?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-critical",
              "leftValue": "={{ $json.new_findings.some(f => f.severity === 'KRITISK') }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "596903d0-b65c-4250-9898-680558358942",
      "name": "Push kritisk - iPhone",
      "notes": "Home Assistant sender videre til telefonen. Punktum-format (/api/notify/...) gir 404.",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        180
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:5678/webhook/varsel-ko?kilde=Daglig%20homelab-diagnose%20/%20Push%20kritisk%20-%20iPhone",
        "authentication": "none",
        "sendHeaders": true,
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ title: 'Homelab: ' + ($json.summary.KRITISK || 0) + ' kritisk, ' + ($json.summary.ADVARSEL || 0) + ' advarsel', message: $json.report_markdown }) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
