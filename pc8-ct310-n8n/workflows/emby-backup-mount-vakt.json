    {
      "id": "6ce17e02-1a9e-4c72-a748-cc2af8fcb2ac",
      "name": "Filtrer nye backup-/NFS-feil",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        300
      ],
      "parameters": {
        "jsCode": "// Emby CT200 config-backup vakt (omskrevet 2026-11-22).\n// pc6 media_recovery.py sjekker og reparerer backup-mounten selv (re-bind uten Emby-restart)\n// og kjører en tapt backup. Reparasjonsvarsel kommer fra \"Media health\"-flyten (hvert 5. min).\n// Denne flyten varsler kun når Emby-backupen FORTSATT er syk, eller når sjekken selv feiler.\nconst sd=$getWorkflowStaticData('global'); const x=$json||{};\nif (x.skipped) return [];\nconst b=(x.services||{})['emby-backup'];\nlet fp=null, title='', msg='';\nif (x.error || !b) { fp='check-error'; title='Emby-backup vakt: sjekken feiler'; msg='media/check svarte ikke med emby-backup-status: '+String(x.error||'mangler').slice(0,300); }\nelse if (!b.ok) { const d=b.detail||{}; fp='unhealthy:'+b.decision; title='Emby-backup: fortsatt feil ('+b.decision+')';\n  msg='Mount OK: '+d.mount_ok+', siste vellykkede backup: '+(d.last_success_age_h==null?'ukjent':d.last_success_age_h+' t siden')+', tjeneste feilet: '+d.service_failed+', reparasjoner siste døgn: '+d.repairs_24h+'. Emby restartes ikke automatisk. Se /var/lib/media-recovery/latest.json på pc6.'; }\nif (!fp) { if (sd.lastFingerprint) { const was=sd.lastFingerprint; sd.lastFingerprint=null; sd.lastAlertAt=0; return [{json:{title:'Emby-backup: frisk igjen',message:'Tidligere tilstand: '+was}}]; } return []; }\nconst now=Date.now(); if (sd.lastFingerprint===fp && now-(sd.lastAlertAt||0)<6*60*60*1000) return [];\nsd.lastFingerprint=fp; sd.lastAlertAt=now;\nreturn [{json:{title,message:msg}}];"
      }
    },
    {
