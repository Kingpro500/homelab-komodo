{
  "id": "tower-media-nfs-health-repair",
  "name": "Media health - deep probes and guarded recovery",
  "description": "Sjekker og reparerer Tower-media NFS hvert 5. min; varsler iPhone ved reparasjon.",
  "active": true,
  "activeVersionId": "740be78d-ec9b-4aed-be08-ca486dabb7f6",
