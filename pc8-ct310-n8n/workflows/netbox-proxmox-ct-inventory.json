      ],
      "parameters": {
        "method": "GET",
        "url": "http://10.0.0.124:8001/api/virtualization/virtual-machines/?limit=1000",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
