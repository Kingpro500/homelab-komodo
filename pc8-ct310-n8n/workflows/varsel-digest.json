      "parameters": {
        "jsCode": "const out = [];\nfor (const it of $input.all()) {\n  const b = it.json.body || {};\n  const q = it.json.query || {};\n  out.push({ json: {\n    title: String(b.title || 'Varsel').slice(0, 200),\n    message: String(b.message || '').slice(0, 2000),\n    kilde: String(q.kilde || b.kilde || '').slice(0, 120),\n  }});\n}\nreturn out;"
      }
