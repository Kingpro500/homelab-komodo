    {
      "id": "644950e2-f870-498b-a26f-0fc44f52ae72",
      "name": "Lag sammendrag",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "jsCode": "// Samler alle koede varsler til én melding (lagt til 2026-11-19).\nconst rows = $input.all().map(i => i.json).filter(r => r && r.id != null);\nif (!rows.length) return [];\nrows.sort((a, b) => a.id - b.id);\nconst fmt = d => new Intl.DateTimeFormat('nb-NO', {timeZone: 'Europe/Oslo', hour: '2-digit', minute: '2-digit'}).format(new Date(d));\nconst groups = new Map();\nfor (const r of rows) {\n  const k = r.title;\n  const g = groups.get(k) || { title: r.title, kilde: r.kilde, n: 0, first: r.createdAt, last: r.createdAt, msg: '' };\n  g.n++; g.last = r.createdAt; g.msg = r.message; groups.set(k, g);\n}\nconst list = [...groups.values()];\nconst crit = g => /kritisk|nede|down|feil|heng|failover/i.test(g.title + ' ' + g.msg) ? 0 : 1;\nlist.sort((a, b) => crit(a) - crit(b) || b.n - a.n);\nlet text = '';\nfor (const g of list) {\n  const when = g.n > 1 ? `${g.n}×, ${fmt(g.first)}–${fmt(g.last)}` : fmt(g.last);\n  const block = `• ${g.title} (${when})` + (g.msg ? `\\n  ${g.msg.replace(/\\s+/g, ' ').slice(0, 220)}` : '') + '\\n';\n  if (text.length + block.length > 3500) { text += `… og ${list.length - list.indexOf(g)} til`; break; }\n  text += block;\n}\nreturn [{ json: {\n  title: `Homelab: ${rows.length} varsel${rows.length === 1 ? '' : 'er'} (${list.length} ulike) siste 6 t`,\n  message: text.trim(),\n  maxId: rows[rows.length - 1].id,\n}}];"
      }
    },
