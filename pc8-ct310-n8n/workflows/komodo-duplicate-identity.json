        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth"
      },
      "id": "Proxmox inventory",
      "name": "Proxmox inventory",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        -500,
        80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://10.0.0.117:9120/read",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"type\":\"ListServers\",\"params\":{}}"
      },
      "id": "Komodo ListServers",
      "name": "Komodo ListServers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        -250,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const a=$input.all().map(x=>x.json); const resources=a[0]?.data||a[0]?.resources||[]; const servers=a[1]?.data||a[1]||[]; const ids=new Set(resources.map(x=>Number(x.vmid)).filter(Number.isInteger)); const g={}; for(const s of servers){const t=[s.name,s.description,s.info?.connect_as,s.info?.address].filter(Boolean).join(' '); const m=t.match(/(?:ct|vm)[-_ ]?(\\d{2,6})/i); if(m&&ids.has(+m[1]))(g[m[1]]??=[]).push({id:s.id,name:s.name});} const d=Object.entries(g).filter(([,v])=>v.length>1).map(([vmid,servers])=>({vmid:+vmid,servers})); if(!d.length)return []; const text=d.map(x=>`CT${x.vmid}: `+x.servers.map(s=>`${s.name} [${s.id}]`).join(' vs ')).join('\\n'); return [{json:{severity:'critical',type:'komodo_duplicate_ct_identity',title:'RØD: flere Komodo-servere med samme CT-nummer',text,incident_id:'komodo-duplicate-ct-'+d.map(x=>x.vmid).join('-'),task:{tittel:'KRITISK: duplikat Komodo-identitet',oppgave:'Diagnostiser funnet. Ikke slett, rename, restart eller flytt noe. Klassifiser kanonisk eier og stopp ved uklart eierskap. Eventuell opprydding krever eksplisitt godkjenning. Funn: '+text,kontroll:'test -s /home/hermes/.hermes/ko/last-result.json',godkjenning:'claude'}}}];"
      },
      "id": "Finn kritiske duplikater",
      "name": "Finn kritiske duplikater",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        80
      ]
    },
