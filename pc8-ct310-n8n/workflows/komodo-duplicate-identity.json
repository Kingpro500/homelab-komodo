        -800,
        180
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://10.0.0.102:8006/api2/json/cluster/resources?type=vm",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth"
      },
      "id": "Proxmox inventory",
      "name": "Proxmox inventory",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        -500,
        80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://10.0.0.117:9120/read",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"type\":\"ListServers\",\"params\":{}}"
      },
      "id": "Komodo ListServers",
      "name": "Komodo ListServers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        -250,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const a=$input.all().map(x=>x.json); const resources=a[0]?.data||a[0]?.resources||[]; const servers=a[1]?.data||a[1]||[]; const pve=new Map(resources.map(x=>[Number(x.vmid),x]).filter(([id])=>Number.isInteger(id))); const identity=s=>{const t=[s.name,s.description,s.info?.connect_as,s.info?.address,s.tags].flat().filter(Boolean).join(' '); const m=t.match(/(?:^|[-_ ]?)(?:ct|vm)[-_ ]?(\\d{2,6})(?:$|[-_ ]?)/i); return m?Number(m[1]):null;}; const details=servers.map(s=>{const vmid=identity(s); return {server_id:s.id??null,server_name:s.name??null,status:s.status??s.info?.status??'unknown',stack_count:Number(s.stack_count??s.stacks_count??(Array.isArray(s.stacks)?s.stacks.length:0)),proxmox_node:pve.get(vmid)?.node??null,vmid,connect_as:s.info?.connect_as??s.connect_as??null};}).filter(x=>x.vmid!==null&&pve.has(x.vmid)); const groups={}; for(const x of details)(groups[x.vmid]??=[]).push(x); const critical_duplicates=Object.entries(groups).filter(([,v])=>v.length>=2).map(([vmid,items])=>({vmid:Number(vmid),servers:items})); if(!critical_duplicates.length)return []; const key=critical_duplicates.flatMap(x=>[x.vmid,...x.servers.map(s=>s.server_id)]).sort().join('-'); const incident_id='komodo-duplicate-ct-'+key; const text=critical_duplicates.map(x=>`CT${x.vmid}: `+x.servers.map(s=>`${s.server_name} [${s.server_id}] status ${s.status} stacks ${s.stack_count} node ${s.proxmox_node||'unknown'} vmid ${s.vmid} connect_as ${s.connect_as||'unknown'}`).join(' vs ')).join('\\n'); return [{json:{severity:'critical',type:'komodo_duplicate_ct_identity',incident_id,critical_duplicates,title:'RØD: flere Komodo-servere med samme CT-nummer',text,task:{tittel:'KRITISK: duplikat Komodo-identitet',oppgave:'Read-only klassifisering. Ikke slett, rename, restart, flytt eller overta noe. Uklar eier stopper videre behandling. Funn: '+text,kontroll:'test -s /home/hermes/.hermes/ko/last-result.json',godkjenning:'claude',ai_failover:'Hermes'}}}];"
      },
      "id": "Finn kritiske duplikater",
      "name": "Finn kritiske duplikater",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        80
      ]
    },
