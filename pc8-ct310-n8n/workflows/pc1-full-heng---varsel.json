    {
      "id": "66f0469a-cfba-499c-b0aa-16a8f174ed5c",
      "name": "Fem feil før varsel",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -250,
        0
      ],
      "parameters": {
        "jsCode": "const sd=$getWorkflowStaticData('global'); const a=$input.all().map(x=>x.json||{}); const nodes=a.find(x=>Array.isArray(x.nodes)); const gpu=a.find(x=>typeof x.data==='string' || typeof x.body==='string'); const plug=a.find(x=>x.entity_id==='switch.pc1_ai'); const pc=nodes&&nodes.nodes?.find(x=>x.node==='pc1'); const pc1ok=!!pc; const gpuok=!!gpu && !gpu.error && String(gpu.data||gpu.body||'').includes('pc1_gpu_exporter_up 1'); const powerOn=plug&&plug.state==='on'; if(pc1ok&&gpuok){sd.fail=0;return[{json:{alert:false,reason:'PC1 og GPU svarer'}}]}; if(!powerOn){sd.fail=0;return[{json:{alert:false,reason:'strømplugg ikke på'}}]}; sd.fail=(sd.fail||0)+1; if(sd.fail<5)return[{json:{alert:false,reason:'venter på fem feil',fail:sd.fail}}]; if(sd.last&&Date.now()-sd.last<3600000)return[{json:{alert:false,reason:'varsel-cooldown',fail:sd.fail}}]; sd.last=Date.now(); sd.fail=0; return[{json:{alert:true,title:'PC1 mulig heng',message:'PC1 svarer ikke fra Proxmox/GPU-exporter i fem minutter, men strømpluggen er fortsatt på. Ingen automatisk strømreset er utført.'}}];"
      }
    },
