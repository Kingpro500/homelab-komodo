{
  "name": "Media health - deep probes and guarded recovery",
  "nodes": [
    {
      "id": "d9dcd2e1-55bd-40a4-9f0b-04b858d7c6cd",
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        260,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "29d886fa-4c1d-46f7-bf3c-f69bb2edfd99",
      "name": "Run guarded media health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput",
      "position": [
        520,
        300
      ],
      "parameters": {
        "url": "http://10.0.0.135:9118/media/check",
        "method": "POST",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Audit-Token",
              "value": "REDACTED_LEGACY_CREDENTIAL"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={}",
        "options": {
          "timeout": 590000
        }
      }
    },
    {
      "id": "bd124761-34e0-4e28-a230-22f874fb2e84",
      "name": "Only actionable report or execution error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        300
      ],
      "parameters": {
        "jsCode": "let report = $json; if ($json.error) report={ok:false,notify:true,error:String($json.error.message ?? $json.error).slice(0,300)}; return report.notify ? [{json:{title:report.ok?'Medietjenester gjenopprettet':'Medievakt: feil eller tiltak',message:JSON.stringify(report).slice(0,3500)}}] : [];"
      }
    },
    {
      "id": "26ace145-23fc-46c4-94af-3a91d3c84f1f",
      "name": "Notify through global hourly throttle",
      "notes": "Home Assistant sender videre til telefonen. Punktum-format (/api/notify/...) gir 404.",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "url": "http://10.0.0.135:9118/notify",
        "method": "POST",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Audit-Token",
              "value": "REDACTED_LEGACY_CREDENTIAL"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({title:$json.title,message:$json.message}) }}",
        "options": {
          "timeout": 30000
        }
      }
    }
  ],
  "connections": {
    "Every 5 minutes": {
      "main": [
        [
          {
            "node": "Run guarded media health",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run guarded media health": {
      "main": [
        [
          {
            "node": "Only actionable report or execution error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Only actionable report or execution error": {
      "main": [
        [
          {
            "node": "Notify through global hourly throttle",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "executionTimeout": 600
  }
}
