# Scanopy SNMP Network Discovery
# Requires NetBox API token and network scanning permissions

# NetBox connection
NETBOX_HOST=http://netbox:8080
NETBOX_TOKEN=your_netbox_api_token_here

# SNMP settings
SNMP_COMMUNITY=public
SNMP_VERSION=2c
SNMP_PORT=161
SNMP_TIMEOUT=5

# Discovery settings
DISCOVERY_THREADS=10
DISCOVERY_TIMEOUT=30
LOG_LEVEL=INFO
