# NetBox PostgreSQL
POSTGRES_USER=netbox
POSTGRES_PASSWORD=change_this_secure_password
POSTGRES_DB=netbox

# NetBox Django settings
SECRET_KEY=change_this_to_a_random_secure_key_min_50_chars
SUPERUSER_USERNAME=admin
SUPERUSER_PASSWORD=change_this_password
SUPERUSER_EMAIL=admin@netbox.local

# Database and Redis
DB_ENGINE=django.db.backends.postgresql
DB_NAME=netbox
DB_USER=netbox
DB_PASSWORD=change_this_secure_password
DB_HOST=postgres
DB_PORT=5432
REDIS_HOST=redis
REDIS_PORT=6379

# Application
ALLOWED_HOSTS=*
TIME_ZONE=UTC
