# Example Stack Environment for Komodo. Real values belong in Komodo's Stack
# Environment (or secret variables), never in Git or a runtime .env file.
#
# Both passwords are used ONLY on the first boot when the CA initializes the
# root + intermediate keys. Generate long, random values and store them in
# Komodo's Stack Environment for pc8-ct102-stepca.

# Password protecting the intermediate/root signing keys.
STEPCA_PASSWORD=change_this_to_a_long_random_password

# Password for the "admin" JWK provisioner (used for ad-hoc `step ca certificate`
# issuance and for `step ca bootstrap`).
STEPCA_ADMIN_PASSWORD=change_this_another_long_random_password

# CA name shown in the UI (optional override; the compose file has a default).
# DOCKER_STEPCA_INIT_NAME="Homelab Internal CA (step-ca)"
