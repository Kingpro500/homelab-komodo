# Grafana Configuration

## Grafana settings
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_this_password

## Database
GF_DATABASE_TYPE=postgres
GF_DATABASE_HOST=postgres:5432
GF_DATABASE_NAME=grafana
GF_DATABASE_USER=grafana
GF_DATABASE_PASSWORD=change_this_secure_password

# PostgreSQL
POSTGRES_USER=grafana
POSTGRES_PASSWORD=change_this_secure_password
POSTGRES_DB=grafana

## Application settings
GF_SERVER_ROOT_URL=http://10.0.0.117:3000
GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=false

## Datasources (configure in Grafana UI after startup)
# NetBox API: URL=http://netbox:8080/api (requires API token in query)
# Prometheus: URL=http://prometheus:9090 (if available)
