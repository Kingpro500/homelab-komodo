#!/usr/bin/env python3
"""nettkart-linjekvalitet — daglig linjekvalitet til nettverkskartet (CT120).

Legger INGEN ny last på linjen. Karakteren regnes ut av målinger som alt finnes:

  * Ping hvert 5. sekund fra pc9 (kabel) til 1.1.1.1  (Prometheus, blackbox-wan-icmp-pc9)
  * MySpeed sin timetest (full last ned/opp i ca. 15 s fra hvert hele klokkeslett)
  * Fysiske WAN-brudd på OPNsense (Hermes, opnsense_wan_flaps_total)

Bufferbloat = median ping mens timetesten laster linjen, minus median ping ellers.
Karakterskalaen er den samme som Waveform bruker (økning i ms under last):
  A+ < 5   A < 30   B < 60   C < 200   D < 400   F >= 400

Skriver /srv/nettkart/www/linjekvalitet.json, som linjekvalitet.html (Gitea) tegner.
Dager som alt er regnet ut beholdes i filen, så historikken overlever at
Prometheus/MySpeed rydder gamle data.

  nettkart-linjekvalitet            # siste 3 døgn regnes på nytt (cron, hver time)
  nettkart-linjekvalitet --dager 30 # fyll historikk

Kilde: GitHub homelab-komodo, scripts/ct120/nettkart-linjekvalitet.
Installeres som /usr/local/sbin/nettkart-linjekvalitet (0755) + /etc/cron.d/nettkart-linjekvalitet.
"""
import datetime as dt
import json
import os
import statistics
import sys
import tempfile
import urllib.parse
import urllib.request
from zoneinfo import ZoneInfo

PROM = os.environ.get("LK_PROM", "http://10.0.0.126:9090")
MYSPEED = os.environ.get("LK_MYSPEED", "http://127.0.0.1:5216")
OUT = os.environ.get("LK_OUT", "/srv/nettkart/www/linjekvalitet.json")
TZ = ZoneInfo("Europe/Oslo")
KEEP_DAYS = 120
PING = 'probe_icmp_duration_seconds{job="blackbox-wan-icmp-pc9",phase="rtt",instance="1.1.1.1"}'
OK = 'probe_success{job="blackbox-wan-icmp-pc9",instance="1.1.1.1"}'
# Timetesten starter på hele timen og varer 11-30 s (snitt 15 s).
LOAD = "({m} and (timestamp({m}) % 3600 >= 2) and (timestamp({m}) % 3600 < 20))".format(m=PING)
IDLE = "({m} and (timestamp({m}) % 3600 >= 120))".format(m=PING)
GRADES = [(5, "A+"), (30, "A"), (60, "B"), (200, "C"), (400, "D")]
PS5_SIGNAL = 'unifi_client_signal_dbm{ip="10.0.0.110"}'
PS5_RETRY = 'unifi_client_retry_ratio{ip="10.0.0.110"}'
PS5_SATISFACTION = 'unifi_client_satisfaction{ip="10.0.0.110"}'
TARGETS = {
    "gateway": "10.0.0.1",
    "cloudflare": "1.1.1.1",
    "quad9": "9.9.9.9",
}
SERVICE_NAMES = {
    "10.0.0.128:6767": "Bazarr",
    "10.0.0.128:8112": "Deluge",
    "10.0.0.128:9696": "Prowlarr",
    "10.0.0.128:7878": "Radarr",
    "10.0.0.128:8787": "Readarr",
    "10.0.0.128:5055": "Seerr",
    "10.0.0.128:8989": "Sonarr",
    "10.0.0.150": "Emby",
    "10.0.0.203": "Emby standby",
    "10.0.0.120:22": "pc6 SSH",
    "10.0.0.120:8006": "pc6 Proxmox",
    "10.0.0.122": "Tunarr",
    "10.0.0.123": "Tunarr",
}


def get(url, timeout=60):
    with urllib.request.urlopen(url, timeout=timeout) as r:
        return json.load(r)


def prom(expr, at):
    q = urllib.parse.urlencode({"query": expr, "time": "%d" % at})
    try:
        res = get("%s/api/v1/query?%s" % (PROM, q))["data"]["result"]
        v = float(res[0]["value"][1]) if res else None
        return None if v is None or v != v else v
    except Exception:
        return None


def prom_results(expr, at):
    q = urllib.parse.urlencode({"query": expr, "time": "%d" % at})
    try:
        return get("%s/api/v1/query?%s" % (PROM, q))["data"]["result"]
    except Exception:
        return []


def uptime_for_day(start, end):
    secs = int((end - start).total_seconds())
    if secs <= 0:
        return {"internett": None, "dns_ekstern": None, "dns_lokal": None,
                "gateway": None, "tjenester": None,
                "tjenester_laveste": {"navn": None, "navn_lesbar": None, "prosent": None}, "dekning": None}
    at = end.timestamp()
    rng = "[%ds]" % secs
    step = max(1, int(secs / 5))
    expected = max(1, int(secs / 5) * 2)
    coverage = prom("sum(count_over_time(probe_success{job=\"blackbox-wan-icmp-pc9\",instance=~\"1.1.1.1|9.9.9.9\"}%s)) / %d" % (rng, expected), at)
    out = {"internett": None, "dns_ekstern": None, "dns_lokal": None,
           "gateway": None, "tjenester": None,
           "tjenester_laveste": {"navn": None, "navn_lesbar": None, "prosent": None},
           "dekning": rnd(None if coverage is None else coverage * 100, 3)}
    if coverage is None or coverage < 0.9:
        return out
    queries = {
        "internett": 'avg_over_time((max(probe_success{job="blackbox-wan-icmp-pc9",instance=~"1.1.1.1|9.9.9.9"}))[%ds:15s])' % secs,
        "dns_ekstern": 'avg_over_time((max(probe_success{job="blackbox-wan-dns-pc9",instance=~"1.1.1.1:53|9.9.9.9:53"}))[%ds:15s])' % secs,
        "dns_lokal": 'avg_over_time(probe_success{job="blackbox-wan-dns-pc9",instance="10.0.0.1:53"}%s)' % rng,
        "gateway": 'avg_over_time(probe_success{job="blackbox-wan-icmp-pc9",instance="10.0.0.1"}%s)' % rng,
        "tjenester": 'avg(avg_over_time(probe_success{job=~"blackbox-http|blackbox-media-services|blackbox-tcp"}%s))' % rng,
    }
    for key, expr in queries.items():
        value = prom(expr, at)
        out[key] = rnd(None if value is None else value * 100, 3)
    lowest = prom_results('bottomk(1, avg_over_time(probe_success{job=~"blackbox-http|blackbox-media-services|blackbox-tcp"}%s))' % rng, at)
    if lowest:
        metric = lowest[0].get("metric", {})
        try:
            value = float(lowest[0]["value"][1]) * 100
            address = metric.get("instance")
            readable = next((name for key, name in SERVICE_NAMES.items() if address and (address == key or (key in ("10.0.0.122", "10.0.0.123") and key in address))), address)
            out["tjenester_laveste"] = {"navn": address, "navn_lesbar": readable, "prosent": rnd(value, 3)}
        except (KeyError, TypeError, ValueError):
            pass
    return out


def latency_for_day(start, end, coverage):
    empty = {"ping_median_ms": None, "ping_p95_ms": None, "ping_maks_ms": None,
             "pakketap_prosent": None, "dns_median_ms": None, "dns_p95_ms": None}
    out = {name: dict(empty) for name in TARGETS}
    if coverage is None or coverage < 90:
        return out
    secs = int((end - start).total_seconds())
    at = end.timestamp()
    sub = "[%ds:5s]" % secs
    rng = "[%ds]" % secs
    for name, ip in TARGETS.items():
        def q(expr):
            return prom(expr, at)
        icmp = 'probe_icmp_duration_seconds{job="blackbox-wan-icmp-pc9",phase="rtt",instance="%s"} > 0' % ip
        dns = 'probe_duration_seconds{job="blackbox-wan-dns-pc9",instance="%s:53"} > 0' % ip
        success = 'probe_success{job="blackbox-wan-icmp-pc9",instance="%s"}' % ip
        out[name] = {
            "ping_median_ms": rnd(q("quantile_over_time(0.5, (%s)%s) * 1000" % (icmp, sub))),
            "ping_p95_ms": rnd(q("quantile_over_time(0.95, (%s)%s) * 1000" % (icmp, sub))),
            "ping_maks_ms": rnd(q("max_over_time((%s)%s) * 1000" % (icmp, sub))),
            "pakketap_prosent": rnd(None if q("avg_over_time(%s%s)" % (success, rng)) is None else (1 - q("avg_over_time(%s%s)" % (success, rng))) * 100, 3),
            "dns_median_ms": rnd(q("quantile_over_time(0.5, (%s)%s) * 1000" % (dns, sub))),
            "dns_p95_ms": rnd(q("quantile_over_time(0.95, (%s)%s) * 1000" % (dns, sub))),
        }
    return out


def grade(ms):
    if ms is None:
        return None
    for lim, g in GRADES:
        if ms < lim:
            return g
    return "F"


def ps5_for_day(start, end):
    if end <= start:
        return None
    secs = int((end - start).total_seconds())
    if secs < 300:
        return None
    at = end.timestamp()
    sub = "[%ds:5m]" % secs
    signal = prom("quantile_over_time(0.5, %s%s)" % (PS5_SIGNAL, sub), at)
    retry = prom("quantile_over_time(0.5, %s%s) * 100" % (PS5_RETRY, sub), at)
    satisfaction = prom("quantile_over_time(0.5, %s%s)" % (PS5_SATISFACTION, sub), at)
    connected = 0
    cursor = start
    while cursor < end:
        hour_end = min(cursor + dt.timedelta(hours=1), end)
        hour_secs = int((hour_end - cursor).total_seconds())
        if hour_secs >= 300:
            count = prom("count_over_time(%s[%ds:5m])" % (PS5_SIGNAL, hour_secs), hour_end.timestamp())
            if count is not None and count > 0:
                connected += 1
        cursor += dt.timedelta(hours=1)
    if signal is None and retry is None and satisfaction is None and connected == 0:
        return None
    return {
        "signal_median_dbm": rnd(signal),
        "retry_median_prosent": rnd(retry),
        "satisfaction_median": rnd(satisfaction),
        "timer_tilkoblet": connected,
    }


def rnd(v, n=1):
    return None if v is None else round(v, n)


def day_row(day, now, tests):
    start = dt.datetime.combine(day, dt.time(), TZ)
    end = min(start + dt.timedelta(days=1), now)
    secs = int((end - start).total_seconds())
    if secs < 600:
        return None
    at = end.timestamp()
    sub = "[%ds:5s]" % secs
    rng = "[%ds]" % secs
    idle = prom("quantile_over_time(0.5, %s%s) * 1000" % (IDLE, sub), at)
    l50 = prom("quantile_over_time(0.5, %s%s) * 1000" % (LOAD, sub), at)
    l95 = prom("quantile_over_time(0.95, %s%s) * 1000" % (LOAD, sub), at)
    lmax = prom("max_over_time(%s%s) * 1000" % (LOAD, sub), at)
    n = prom("count_over_time(%s%s)" % (LOAD, sub), at)
    i95 = prom("quantile_over_time(0.95, %s%s) * 1000" % (IDLE, sub), at)
    okavg = prom("avg_over_time(%s%s)" % (OK, rng), at)
    flaps = prom("increase(opnsense_wan_flaps_total%s)" % rng, at)
    down_s = prom("increase(opnsense_wan_flap_downtime_seconds_total%s)" % rng, at)
    bloat = None if idle is None or l50 is None or (n or 0) < 12 else max(0.0, l50 - idle)
    t = [x for x in tests if start <= x["t"] < end]
    good = [x for x in t if x["down"] > 0]
    goodup = [x for x in t if x["up"] > 0]
    failed = [x for x in t if x["down"] <= 0 or x["up"] <= 0]
    row = {
        "dato": day.isoformat(),
        "delvis": end < start + dt.timedelta(days=1),
        "karakter": grade(bloat),
        "bufferbloat_ms": rnd(bloat),
        "ping_hvile_ms": rnd(idle),
        "ping_hvile_p95_ms": rnd(i95),
        "ping_last_ms": rnd(l50),
        "ping_last_p95_ms": rnd(l95),
        "ping_last_maks_ms": rnd(lmax),
        "malinger_under_last": int(n or 0),
        "pakketap_prosent": rnd(None if okavg is None else 100 * (1 - okavg), 3),
        "wan_brudd": None if flaps is None else int(round(flaps)),
        "wan_nedetid_s": None if down_s is None else int(round(down_s)),
        "fartstester": len(t),
        "fartstester_feilet": len(failed),
        "ned_median": rnd(statistics.median(x["down"] for x in good)) if good else None,
        "ned_min": rnd(min(x["down"] for x in good)) if good else None,
        "opp_median": rnd(statistics.median(x["up"] for x in goodup)) if goodup else None,
        "opp_min": rnd(min(x["up"] for x in goodup)) if goodup else None,
        "ps5": ps5_for_day(start, end),
        "oppetid": uptime_for_day(start, end),
    }
    row["latens"] = latency_for_day(start, end, row["oppetid"].get("dekning"))
    # En dag uten noen data i det hele tatt lagres ikke (kilden fantes ikke ennå).
    if row["ping_hvile_ms"] is None and not t and row["wan_brudd"] is None:
        return None
    return row


def main():
    days = 3
    if "--dager" in sys.argv:
        days = int(sys.argv[sys.argv.index("--dager") + 1])
    now = dt.datetime.now(TZ)
    try:
        raw = get("%s/api/speedtests?hours=%d&limit=5000" % (MYSPEED, days * 24 + 48))
    except Exception:
        raw = []
    tests = []
    for r in raw:
        try:
            tests.append({"t": dt.datetime.fromisoformat(r["created"].replace("Z", "+00:00")),
                          "down": float(r.get("download") or -1), "up": float(r.get("upload") or -1)})
        except Exception:
            pass
    try:
        with open(OUT, encoding="utf-8") as fh:
            old = {d["dato"]: d for d in json.load(fh).get("dager", [])}
    except Exception:
        old = {}
    for i in range(days):
        day = (now - dt.timedelta(days=i)).date()
        row = day_row(day, now, tests)
        if row:
            # Behold en ferdig dag hvis kilden i mellomtiden er ryddet bort.
            prev = old.get(row["dato"])
            if prev and not prev.get("delvis") and row["ping_hvile_ms"] is None and prev.get("ping_hvile_ms") is not None:
                continue
            old[row["dato"]] = row
    cutoff = (now - dt.timedelta(days=KEEP_DAYS)).date().isoformat()
    rows = [old[k] for k in sorted(old) if k >= cutoff]
    doc = {
        "generert": now.isoformat(timespec="seconds"),
        "generert_lokal": now.strftime("%d.%m.%Y %H:%M %Z"),
        "metode": "Ping hvert 5. s fra pc9 (kabel) til 1.1.1.1. Under last = sekund 2-20 etter hver hele time, "
                  "mens MySpeed laster linjen fullt. Bufferbloat = median under last minus median ellers. "
                  "Skala som Waveform: A+ <5, A <30, B <60, C <200, D <400 ms, ellers F.",
        "dager": rows,
    }
    d = os.path.dirname(OUT)
    fd, tmp = tempfile.mkstemp(prefix=".linjekvalitet.", dir=d)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump(doc, fh, ensure_ascii=False, indent=1)
    os.chmod(tmp, 0o644)
    os.replace(tmp, OUT)
    last = rows[-1] if rows else {}
    print("linjekvalitet: %d dager, siste %s karakter %s (bufferbloat %s ms)" % (
        len(rows), last.get("dato"), last.get("karakter"), last.get("bufferbloat_ms")))


if __name__ == "__main__":
    main()
