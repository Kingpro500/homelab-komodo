    {
      "id": "9f04554a-d5cf-4e8d-ad72-14be642be1dd",
      "name": "Formater rapport",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -20,
        160
      ],
      "parameters": {
        "jsCode": "const d = $json;\nconst lan = d.lan || {};\nconst wan = d.wan || {};\nconst flaps = lan.flaps_24h || {};\nlet m = 'Tjenester: ' + d.services_up + '/' + d.services_total + '\\n';\nm += 'WAN: ' + (wan.wan_outages_1h || 0) + ' hopp siste time, '\n     + Math.round(wan.wan_downtime_s_1h || 0) + ' sek nede\\n';\nm += 'LAN: ' + (lan.hosts || 0) + ' enheter';\nif (lan.conflicts && Object.keys(lan.conflicts).length) {\n  m += ', ' + Object.keys(lan.conflicts).length + ' ARP-konflikt'; }\nm += '\\nFysiske hopp siste døgn: '\n     + (Object.keys(flaps).length ? Object.entries(flaps).map(([k,v]) => k + '=' + v).join(', ') : 'ingen') + '\\n';\nm += 'WAN-flaps siste doegn (klokketime): '\n     + (lan.flaps_hour_24h && lan.flaps_hour_24h.length ? lan.flaps_hour_24h.join('  ') : 'ingen') + '\\n';\nm += 'Port-counters (CRC/drops): ikke tilgjengelig via OPNsense-API\\n';\nif (d.services_down && d.services_down.length) {\n  m += '\\nNede: ' + d.services_down.join(', ') + '\\n'; }\nif (d.problems && d.problems.length) {\n  m += '\\nAktive problemer:\\n' + d.problems.map(p => '- [' + p.sev + '] ' + p.text).join('\\n') + '\\n'; }\nelse { m += '\\nIngen aktive problemer.\\n'; }\nreturn [{ json: { tittel: d.all_clear ? 'Nettverk: alt OK' : 'Nettverk: ' + d.problems.length + ' problemer', rapport: m } }];"
      }
    },
    {
