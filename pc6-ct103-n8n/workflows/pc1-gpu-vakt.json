      "parameters": {
        "jsCode": "const alerts = ($json.body && $json.body.alerts) || $json.alerts || [];\nconst out=[];\nfor (const a of alerts) {\n  if (a.status !== 'firing') continue;\n  const n = a.labels && a.labels.alertname;\n  if (n === 'PC1GPUTemperatureCritical') out.push({json:{node:'pc1',vmid:350,action:'off',reason:'GPU kritisk varm'}});\n  if (n === 'PC1GPUTemperatureHigh' || n === 'PC1GPUTemperatureCritical') out.push({json:{node:'pc1',vmid:102,action:'off',reason:'GPU varm - frigjor PC1'}});\n}\nif (!out.length) return [{json:{skipped:true,reason:'Ingen aktiv PC1 GPU-alarm'}}];\nreturn out;"
      }
    },
