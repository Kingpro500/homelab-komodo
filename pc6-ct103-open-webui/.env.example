# pc6-ct103-open-webui: example Stack Environment for Komodo.
# Real values belong in Komodo (Stack -> Environment), never in Git.

# Address and port. Must not collide with another stack on this CT.
OPEN_WEBUI_BIND_IP=10.0.0.119
OPEN_WEBUI_PORT=3080
TZ=Europe/Oslo

# Secrets: references to Komodo secret variables.
OPEN_WEBUI_SECRET_KEY=[[OPEN_WEBUI_SECRET_KEY]]
OPENROUTER_API_KEY_WEBUI=[[OPENROUTER_API_KEY_WEBUI]]

# Pin to a released tag once this has proven stable; 'main' tracks HEAD.
OPEN_WEBUI_VERSION=main

# Local inference on pc1 is CPU-only today. Leave off until GPU access works.
ENABLE_OLLAMA_API=false
OLLAMA_URL=http://10.0.0.133:11434

ENABLE_MODEL_USAGE=true
ENABLE_SIGNUP=false
